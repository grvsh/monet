# Copy to .env.local for local frontend development against a remote backend.
# Vite reads .env.local automatically; it is gitignored.

# URL of the backend API server. Defaults to http://localhost:8000 when unset.
# VITE_API_URL=http://192.168.1.x:8000

# Comma-separated hostnames the Vite dev server accepts connections from.
# Defaults to allow-all when unset. Set this if you access dev from a hostname.
# VITE_ALLOWED_HOSTS=<monet-dev-host>,localhost
