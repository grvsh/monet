# Copy to .env and fill in values before running docker-compose

# ── Database ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=change_me_generate_a_real_postgres_password
DATABASE_URL=postgresql+asyncpg://monet:${POSTGRES_PASSWORD}@db:5432/monet

# ── Redis ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=change_me_generate_a_real_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Media library ───────────────────────────────────────────────────────────
# Host path to your photo/video library. Must be the same inside and outside
# the container so that paths stored in the database resolve correctly.
# Example: MONET_MEDIA_PATH=/mnt/photos
MONET_MEDIA_PATH=/mnt/media

# ── Cache ───────────────────────────────────────────────────────────────────
# Host path where thumbnails and previews are stored.
# Change this to any directory your server can write to — e.g. a NAS data
# drive: MONET_CACHE_PATH=/mnt/data/monet/cache
# The directory will be created automatically by Docker if it does not exist.
MONET_CACHE_PATH=/opt/monet/cache

# ── Server ──────────────────────────────────────────────────────────────────
MONET_HOST=0.0.0.0
MONET_PORT=8000
MONET_LOG_LEVEL=info
# Host-side ports exposed by Docker. Change if 80 or 8000 conflict with other
# services on your machine (e.g. MONET_HTTP_PORT=8080, MONET_API_PORT=8001).
MONET_HTTP_PORT=80
MONET_API_PORT=8000

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_real_secret_with_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Media processing ────────────────────────────────────────────────────────
MONET_THUMB_SIZE=480
MONET_PREVIEW_MAX_WIDTH=3840
MONET_PREVIEW_MAX_HEIGHT=2160
MONET_THUMB_QUALITY=85
MONET_PREVIEW_QUALITY=90

# ── Indexing ────────────────────────────────────────────────────────────────
MONET_WORKER_CONCURRENCY=4
MONET_WATCH_ENABLED=true
MONET_SCAN_ON_STARTUP=true
MONET_FILE_SETTLE_SECONDS=2

# ── CORS (comma-separated allowed origins) ──────────────────────────────────
MONET_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Security ─────────────────────────────────────────────────────────────────
# Directories the admin may browse when adding root folders.
# Restrict to your NAS mount points — do NOT include /etc, /root, etc.
MONET_BROWSE_ROOTS=/mnt,/media,/srv,/data

# Set true when running behind HTTPS (nginx + TLS). Makes the refresh-token
# cookie Secure so it is never transmitted over plain HTTP.
MONET_SECURE_COOKIES=false

# Max login attempts per IP per minute before 429 Too Many Requests.
LOGIN_RATE_LIMIT=10/minute

# ── ML service (optional) ────────────────────────────────────────────────────
# URL of the monet-ml inference service. Leave empty to disable AI features.
#
# Same machine (docker-compose.yml + docker-compose.ml.yml merged):
#   MONET_ML_SERVICE_URL=http://ml-service:8100
#
# Separate GPU machine:
#   MONET_ML_SERVICE_URL=http://192.168.1.50:8100
MONET_ML_SERVICE_URL=

# Bearer token for the ML service. Must match ML_API_KEY in docker-compose.ml.yml.
# Leave empty when running on an isolated Docker bridge network (same machine).
MONET_ML_API_KEY=

# Number of images per batch sent to the ML service (tune for VRAM vs latency).
MONET_ML_BATCH_SIZE=32

# Longest side in pixels for the analysis image derived from the preview.
# 768 covers all model native input sizes without wasteful transfer.
MONET_ML_IMAGE_SIZE=768

# ── ML service config (set in docker-compose.ml.yml or here for standalone) ──
# API key the ml-service requires on incoming requests. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ML_API_KEY=

# Remove features from the list to disable their model and free VRAM.
ML_ENABLED_FEATURES=clip_embedding,dino_embedding,caption,faces,objects,aesthetic_score

# Images the ML service accepts per /analyze call (must match MONET_ML_BATCH_SIZE).
ML_BATCH_SIZE=32
