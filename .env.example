# Copy to .env and fill in values before running docker-compose

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://monet:${POSTGRES_PASSWORD}@db:5432/monet

# ── Redis ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=change_me_generate_a_real_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Cache ───────────────────────────────────────────────────────────────────
MONET_CACHE_DIR=/var/monet/cache

# ── Server ──────────────────────────────────────────────────────────────────
MONET_HOST=0.0.0.0
MONET_PORT=8000
MONET_LOG_LEVEL=info

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_real_secret_with_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Media processing ────────────────────────────────────────────────────────
MONET_THUMB_SIZE=480
MONET_PREVIEW_MAX_WIDTH=3840
MONET_PREVIEW_MAX_HEIGHT=2160
MONET_THUMB_QUALITY=85
MONET_PREVIEW_QUALITY=90

# ── Indexing ────────────────────────────────────────────────────────────────
MONET_WORKER_CONCURRENCY=4
MONET_WATCH_ENABLED=true
MONET_SCAN_ON_STARTUP=true
MONET_FILE_SETTLE_SECONDS=2

# ── CORS (comma-separated allowed origins) ──────────────────────────────────
MONET_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Security ─────────────────────────────────────────────────────────────────
# Directories the admin may browse when adding root folders.
# Restrict to your NAS mount points — do NOT include /etc, /root, etc.
MONET_BROWSE_ROOTS=/mnt,/media,/srv,/data

# Set true when running behind HTTPS (nginx + TLS). Makes the refresh-token
# cookie Secure so it is never transmitted over plain HTTP.
MONET_SECURE_COOKIES=false

# Max login attempts per IP per minute before 429 Too Many Requests.
LOGIN_RATE_LIMIT=10/minute
